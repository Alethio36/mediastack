# ============================================================================
# Mediastack configuration
# ----------------------------------------------------------------------------
# Copy to `.env` (or let `./mediastack.sh configure` write it for you — the
# wizard explains every setting). This file is the single source of truth:
# the script and compose read everything from here and never edit tracked
# files. `.env` is gitignored; it contains secrets.
# ============================================================================

# Schema version — managed by mediastack.sh, do not edit by hand.
ENV_SCHEMA=29

# ---------------------------------------------------------------- Timezone --
# Your host timezone (IANA name, e.g. Australia/Adelaide, America/Chicago).
# The wizard defaults this from the host and validates it.
TZ=Etc/UTC

# ------------------------------------------------------------------- Roots --
# CONFIG_ROOT  service configs (databases). LOCAL DISK ONLY — SQLite databases
#              corrupt on NFS/SMB shares. The tooling refuses network paths.
# DATA_ROOT    your media + torrent tree. NAS/big disk is fine. Keep the
#              torrent dir and media dir on the SAME filesystem or imports
#              become slow full copies instead of instant hardlinks.
# CACHE_ROOT   disposable, re-derivable data (image caches, metadata, the
#              search index). Network storage is fine.
# TRANSCODE_ROOT  video segments written while someone watches: a few GB per
#              stream at the video's bitrate, gone when the stream ends.
#              LOCAL disk (or a tmpfs) — a network share stutters playback.
# BACKUP_ROOT  where restore points land. Network storage is ENCOURAGED —
#              backups on the same disk as the configs aren't backups.
# Relative paths are resolved against the repo directory by `configure`,
# which stores them absolute; a hand-copied .env with relative roots is
# refused by up/enable/backup and flagged by doctor (compose would resolve
# them against compose.d/ instead).
CONFIG_ROOT=./config
DATA_ROOT=./data
CACHE_ROOT=./cache
TRANSCODE_ROOT=./transcodes
BACKUP_ROOT=./backups

# Media subdirectory names under ${DATA_ROOT}/media, one per arr instance.
# The defaults are mediastack's convention; change them when the tree you
# bring already uses other names (e.g. tvshows). The arrs' root folders,
# the directories `configure` provisions and the Jellyfin libraries `wire`
# derives all follow these. Torrent categories and dirs are not affected.
MEDIA_DIR_MOVIES=movies
MEDIA_DIR_MOVIES_4K=movies-4k
MEDIA_DIR_TV=tv
MEDIA_DIR_TV_ANIME=tv-anime
MEDIA_DIR_MUSIC=music

# Optional: relocate Jellyfin's metadata tree (artwork — often the single
# largest config consumer). COPY the existing directory first, then uncomment
# the matching volume line in compose.d/core.yml.
#JELLYFIN_METADATA_DIR=

# ---------------------------------------------------------------- Services --
# Which services run — one name per service, pick anything à la carte.
# The wizard (and enable/disable) manage this and resolve dependencies
# (e.g. qbittorrent requires gluetun; jellysearch requires jellyfin +
# meilisearch). Full catalogue: ./mediastack.sh status
COMPOSE_PROFILES=gluetun,qbittorrent,sonarr,radarr,prowlarr,jellyfin,meilisearch,jellysearch,seerr

# ------------------------------------------------------- Users/permissions --
# One system group shared by all services (data-tree access), one UID per
# service (ownership + fault attribution). Defaults follow the TRaSH-style
# 13000 range; change UID_BASE if that range is taken on your host.
# `./mediastack.sh configure` provisions users/dirs from this map and
# `doctor` audits against it — they can never disagree.
MEDIA_GROUP_GID=13000
UID_BASE=13000
SONARR_UID=13001
RADARR_UID=13002
LIDARR_UID=13003
PROWLARR_UID=13006
QBITTORRENT_UID=13007
JELLYFIN_UID=13010
SEERR_UID=13012
BAZARR_UID=13013
DELUGE_UID=13014
TRANSMISSION_UID=13015
MEILISEARCH_UID=13017
RADARR_4K_UID=13018
SONARR_ANIME_UID=13019
WIZARR_UID=13021
APPRISE_UID=13022
CLEANUPARR_UID=13023
WATCHSTATE_UID=13024
NAVIDROME_UID=13025
AUDIOBOOKSHELF_UID=13026
KAVITA_UID=13027
LAZYLIBRARIAN_UID=13028
AUTHENTIK_UID=13029
# OliveTin (the web panel) runs as a dedicated host user that
# `frontdoor-install` creates and fills in here; leave these empty.
OLIVETIN_UID=
OLIVETIN_GID=

# --------------------------------------------------------------------- VPN --
# VPN_PROVIDER: any gluetun-supported provider (nordvpn, mullvad, protonvpn,
# surfshark, ...) or `custom` for a manual WireGuard config.
# For nordvpn the wizard can fetch WIREGUARD_PRIVATE_KEY from your account
# token automatically; other providers: follow gluetun's wiki for your
# provider and paste the key here.
VPN_PROVIDER=nordvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.5.0.2/32
# Server selection (comma-separated; leave unused ones empty). Prefer
# countries over hardcoded hostnames — hostnames don't fail over.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=
VPN_SERVER_HOSTNAMES=
VPN_DNS_ADDRESS=

# ------------------------------------------------------------ App accounts --
# Written by `wire` (user-chosen or generated). View any time: credentials
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
# One shared login for every arr instance + bazarr (they share one operator)
ARR_USER=
ARR_PASSWORD=

# ----------------------------------------------------------------- Secrets --
# Meilisearch master key (search profile). Machine-to-machine secret;
# `configure` generates it — never typed by a human.
MEILI_MASTER_KEY=
# Cloudflare tunnel token (tunnel profile).
CLOUDFLARE_TUNNEL_TOKEN=
# Pi-hole admin password (dns profile).
PIHOLE_PASSWORD=

# ----------------------------------------------------------------- Updates --
# UPDATE_SCHEDULE: systemd OnCalendar expression, set by the wizard's
# schedule chooser. Empty = no timer, manual `update` only.
#   "Tue 04:00"        every Tuesday 4am
#   "Mon..Fri 03:30"   weekdays 3:30am
#   "*-*-* 04:00"      every day 4am
UPDATE_SCHEDULE=
# Per-service toggles (true = included in automatic updates).
GLUETUN_UPDATE=true
QBITTORRENT_UPDATE=true
SONARR_UPDATE=true
RADARR_UPDATE=true
PROWLARR_UPDATE=true
JELLYFIN_UPDATE=true
MEILISEARCH_UPDATE=true
JELLYSEARCH_UPDATE=true
SEERR_UPDATE=true
LIDARR_UPDATE=true
BAZARR_UPDATE=true
PIHOLE_UPDATE=true
CLOUDFLARED_UPDATE=true
FLARESOLVERR_UPDATE=true
DELUGE_UPDATE=true
TRANSMISSION_UPDATE=true
ERSATZTV_UPDATE=true
RADARR_4K_UPDATE=true
SONARR_ANIME_UPDATE=true
WIZARR_UPDATE=true
APPRISE_UPDATE=true
CLEANUPARR_UPDATE=true
WATCHSTATE_UPDATE=true
NAVIDROME_UPDATE=true
AUDIOBOOKSHELF_UPDATE=true
KAVITA_UPDATE=true
LAZYLIBRARIAN_UPDATE=true
AUTHENTIK_UPDATE=true
NPM_UPDATE=true
# Defer updates while someone is actively streaming (needs JELLYFIN_API_KEY —
# 'wire jellyfin' fills it automatically).
UPDATE_DEFER_IF_ACTIVE=true
UPDATE_DEFER_RETRY_MIN=30
UPDATE_DEFER_MAX_MIN=180
# after the longest deferral: proceed | skip
UPDATE_DEFER_ACTION=proceed
# Heads-up to the users stream before a Jellyfin-affecting update recreates it
# (only when someone is streaming). Seconds of lead time; 0 = warn without pausing.
NOTIFY_GRACE=30
JELLYFIN_API_KEY=

# ----------------------------------------------------------------- Backups --
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Scoped restore points from targeted `update <svc>` land in a SEPARATE
# pre-update/ pool that the daily/weekly/monthly schedule above never touches.
# This keeps only the newest N of them (the "undo that update" safety net).
BACKUP_KEEP_PREUPDATE=3

# ----------------------------------------------------------- Media manifest --
# A read-only snapshot of every file under DATA_ROOT/media, kept in
# BACKUP_ROOT/manifest/. Answers "when did X disappear?" (manifest find) and
# alerts the ops stream when a folder loses media files. Arr renames and
# upgrades are not losses. Keep BACKUP_ROOT off the media disk: the manifest
# is the shopping list you need if that disk dies.
# MANIFEST_SCHEDULE: systemd OnCalendar expression; empty = no timer.
MANIFEST_SCHEDULE=*-*-* 03:30
MANIFEST_KEEP_DAYS=365
# A snapshot whose media-file count fell more than this % is NOT recorded
# (usually an unmounted share); `manifest --accept` records an intended one.
MANIFEST_ALERT_PCT=5

# --------------------------------------------------- Deletion attribution --
# Opt-in: the kernel logs every delete and rename under DATA_ROOT/media with
# who made it (each service runs as its own *_UID). Set by
# `./mediastack.sh audit on|off`, which install/remove the watch — editing
# this alone changes nothing on the host (doctor flags the mismatch).
AUDIT_ENABLED=false
# Days of history kept in BACKUP_ROOT/audit/ (`audit report` reads it).
# `audit on` asks; change it here any time — the next hourly copy prunes to it.
AUDIT_KEEP_DAYS=365

# ------------------------------------------------------- Arr recycle bin --
# ON by default. Files an arr (Radarr/Sonarr/Lidarr) deletes — including the
# old copy it replaces on an upgrade — are MOVED here instead of deleted, one
# folder per arr, and the arrs remove them after RECYCLE_DAYS (0 = never).
# It needs room on the media drive for that many days of deletes and upgrades
# (a 4K remux can be 50+ GB). doctor and the nightly manifest warn when it
# holds over 10% of the drive or the drive is under 10% free; mediastack never
# deletes from it itself. Applied by: ./mediastack.sh wire arr
# RECYCLE_ROOT: empty = DATA_ROOT/recycle. Must be inside DATA_ROOT (the arrs
# see it there), outside DATA_ROOT/media, and on the same drive as the media.
RECYCLE_ENABLED=true
RECYCLE_ROOT=
RECYCLE_DAYS=7

# -------------------------------------------------------------------- Logs --
# Per-container log rotation (docker json-file driver).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ------------------------------------------------------------------- Extra --
# Jellyfin public URL (behind proxy/tunnel), e.g. https://jellyfin.example.com
JELLYFIN_PUBLISHED_URL=
# Container name overrides (default: mediastack-<service>), e.g.:
#JELLYFIN_NAME=jellyfin
# Host port overrides, e.g.:
#JELLYFIN_PORT=8096
#APPRISE_PORT=8000
#TRAEFIK_HTTP_PORT=80
#NPM_HTTP_PORT=80

# ------------------------------------------------------------ HTTPS edge --
# Traefik is optional: enable traefik, then `traefik-setup` asks for the
# domain, the Cloudflare DNS token and the certificate environment and
# writes them here (TRAEFIK_DOMAIN, ACME_EMAIL, ACME_ENV, dashboard login).
# The token is declared empty so a render never warns before that; the
# generated config is what actually needs it.
CF_DNS_API_TOKEN=
TRAEFIK_DOMAIN=
ACME_EMAIL=
ACME_ENV=
TRAEFIK_DASH_USER=
TRAEFIK_DASH_PASSWORD=

# ---- Mount identity (written by configure; used by require_mounts) ---------
# CONFIG_ROOT_SOURCE=
# DATA_ROOT_SOURCE=
# CACHE_ROOT_SOURCE=
# TRANSCODE_ROOT_SOURCE=
# BACKUP_ROOT_SOURCE=

# ------------------------------------------------------------- authentik --
# The portal (one login for every app). Generated at its first `up`; the
# admin login: ./mediastack.sh credentials. Never change these once its
# database exists — the database was created with them.
PORTAL_TITLE=Mediastack
# managed by the script: 127.0.0.1: while authentik guards the admin tools
MEDIASTACK_GATE_BIND=
MEDIASTACK_GATE_TRUST=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_ADMIN_PASSWORD=
AUTHENTIK_API_TOKEN=
AUTHENTIK_LDAP_BIND_PASSWORD=
AUTHENTIK_LDAP_TOKEN=
AUTHENTIK_ABS_CLIENT_SECRET=

# ---------------------------------------------------------------- network --
# The stack network's range and Traefik's fixed address in it (Traefik sits
# outside the range containers draw from). Change all three together, only if
# the default clashes with your LAN.
MEDIASTACK_SUBNET=172.31.250.0/24
MEDIASTACK_IP_RANGE=172.31.250.128/25
TRAEFIK_ADDRESS=172.31.250.2

# ---------------------------------------------------------- audiobookshelf --
# Its root account is the stack's own: wire audiobookshelf creates it on a
# fresh install (see: credentials). People sign in with their own accounts.
ABS_ADMIN_USER=
ABS_ADMIN_PASSWORD=
