# ============================================================================
# Mediastack configuration
# ----------------------------------------------------------------------------
# Copy to `.env` (or let `./mediastack.sh configure` write it for you — the
# wizard explains every setting). This file is the single source of truth:
# the script and compose read everything from here and never edit tracked
# files. `.env` is gitignored; it contains secrets.
# ============================================================================

# Schema version — managed by mediastack.sh, do not edit by hand.
ENV_SCHEMA=6

# ---------------------------------------------------------------- Timezone --
# Your host timezone (IANA name, e.g. Australia/Adelaide, America/Chicago).
# The wizard defaults this from the host and validates it.
TZ=Etc/UTC

# ------------------------------------------------------------------- Roots --
# CONFIG_ROOT  service configs (databases). LOCAL DISK ONLY — SQLite databases
#              corrupt on NFS/SMB shares. The tooling refuses network paths.
# DATA_ROOT    your media + torrent tree. NAS/big disk is fine. Keep the
#              torrent dir and media dir on the SAME filesystem or imports
#              become slow full copies instead of instant hardlinks.
# CACHE_ROOT   disposable, re-derivable data (transcodes, image caches,
#              search index). Network storage is fine.
# BACKUP_ROOT  where restore points land. Network storage is ENCOURAGED —
#              backups on the same disk as the configs aren't backups.
# Relative paths are resolved against the repo directory at configure time.
CONFIG_ROOT=./config
DATA_ROOT=/srv/mediastack/data
CACHE_ROOT=./cache
BACKUP_ROOT=./backups

# Optional: relocate Jellyfin's metadata tree (artwork — often the single
# largest config consumer). COPY the existing directory first, then uncomment
# the matching volume line in compose.d/core.yml.
#JELLYFIN_METADATA_DIR=

# ---------------------------------------------------------------- Services --
# Which services run — one name per service, pick anything à la carte.
# The wizard (and enable/disable) manage this and resolve dependencies
# (e.g. qbittorrent requires gluetun; jellysearch requires jellyfin +
# meilisearch). Full catalogue: ./mediastack.sh status
COMPOSE_PROFILES=gluetun,qbittorrent,sonarr,radarr,prowlarr,jellyfin,npm,meilisearch,jellysearch,seerr

# ------------------------------------------------------- Users/permissions --
# One system group shared by all services (data-tree access), one UID per
# service (ownership + fault attribution). Defaults follow the TRaSH-style
# 13000 range; change UID_BASE if that range is taken on your host.
# `./mediastack.sh configure` provisions users/dirs from this map and
# `doctor` audits against it — they can never disagree.
MEDIA_GROUP_GID=13000
UID_BASE=13000
SONARR_UID=13001
RADARR_UID=13002
LIDARR_UID=13003
PROWLARR_UID=13006
QBITTORRENT_UID=13007
JELLYFIN_UID=13010
SEERR_UID=13012
BAZARR_UID=13013
DELUGE_UID=13014
TRANSMISSION_UID=13015
MEILISEARCH_UID=13017
RADARR_4K_UID=13018
SONARR_ANIME_UID=13019
WIZARR_UID=13021

# --------------------------------------------------------------------- VPN --
# VPN_PROVIDER: any gluetun-supported provider (nordvpn, mullvad, protonvpn,
# surfshark, ...) or `custom` for a manual WireGuard config.
# For nordvpn the wizard can fetch WIREGUARD_PRIVATE_KEY from your account
# token automatically; other providers: follow gluetun's wiki for your
# provider and paste the key here.
VPN_PROVIDER=nordvpn
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.5.0.2/32
# Server selection (comma-separated; leave unused ones empty). Prefer
# countries over hardcoded hostnames — hostnames don't fail over.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=
VPN_SERVER_HOSTNAMES=
VPN_DNS_ADDRESS=

# ------------------------------------------------------------ App accounts --
# Written by `wire` (user-chosen or generated). View any time: credentials
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=
# One shared login for every arr instance + bazarr (they share one operator)
ARR_USER=
ARR_PASSWORD=

# ----------------------------------------------------------------- Secrets --
# Meilisearch master key (search profile). Machine-to-machine secret;
# `configure` generates it — never typed by a human.
MEILI_MASTER_KEY=
# Cloudflare tunnel token (tunnel profile).
CLOUDFLARE_TUNNEL_TOKEN=
# Pi-hole admin password (dns profile).
PIHOLE_PASSWORD=

# ----------------------------------------------------------------- Updates --
# UPDATE_SCHEDULE: systemd OnCalendar expression, set by the wizard's
# schedule chooser. Empty = no timer, manual `update` only.
#   "Tue 04:00"        every Tuesday 4am
#   "Mon..Fri 03:30"   weekdays 3:30am
#   "*-*-* 04:00"      every day 4am
UPDATE_SCHEDULE=
# Per-service toggles (true = included in automatic updates).
GLUETUN_UPDATE=true
QBITTORRENT_UPDATE=true
SONARR_UPDATE=true
RADARR_UPDATE=true
PROWLARR_UPDATE=true
JELLYFIN_UPDATE=true
NPM_UPDATE=true
MEILISEARCH_UPDATE=true
JELLYSEARCH_UPDATE=true
SEERR_UPDATE=true
LIDARR_UPDATE=true
BAZARR_UPDATE=true
PIHOLE_UPDATE=true
CLOUDFLARED_UPDATE=true
FLARESOLVERR_UPDATE=true
DELUGE_UPDATE=true
TRANSMISSION_UPDATE=true
ERSATZTV_UPDATE=true
RADARR_4K_UPDATE=true
SONARR_ANIME_UPDATE=true
WIZARR_UPDATE=true
# Defer updates while someone is actively streaming (needs JELLYFIN_API_KEY —
# 'wire jellyfin' fills it automatically).
UPDATE_DEFER_IF_ACTIVE=false
UPDATE_DEFER_RETRY_MIN=30
UPDATE_DEFER_MAX_MIN=180
UPDATE_DEFER_ACTION=proceed   # proceed|skip after max deferral
JELLYFIN_API_KEY=

# ----------------------------------------------------------------- Backups --
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# -------------------------------------------------------------------- Logs --
# Per-container log rotation (docker json-file driver).
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ------------------------------------------------------------------- Extra --
# Jellyfin public URL (behind proxy/tunnel), e.g. https://jellyfin.example.com
JELLYFIN_PUBLISHED_URL=
# Container name overrides (default: mediastack-<service>), e.g.:
#JELLYFIN_NAME=jellyfin
# Host port overrides, e.g.:
#JELLYFIN_PORT=8096
#NPM_HTTP_PORT=80

# ---- Mount identity (written by configure; used by require_mounts) ---------
# CONFIG_ROOT_SOURCE=
# DATA_ROOT_SOURCE=
# CACHE_ROOT_SOURCE=
# BACKUP_ROOT_SOURCE=
