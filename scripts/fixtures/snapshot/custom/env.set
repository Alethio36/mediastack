# what you add: a drop-in service, an override, a Traefik route of your own
COMPOSE_PROFILES=gluetun,qbittorrent,sonarr,radarr,prowlarr,jellyfin,traefik,hello
STACK_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=fixture-cloudflare-token
TRAEFIK_DASH_USER=admin
TRAEFIK_DASH_PASSWORD=fixture-dash-password
ACME_ENV=production
