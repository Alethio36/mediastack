{
  "networks": {
    "mediastack": {
      "ipam": {
        "config": [
          {
            "ip_range": "172.31.250.128/25",
            "subnet": "172.31.250.0/24"
          }
        ]
      },
      "name": "mediastack"
    }
  },
  "services": {
    "apprise": {
      "container_name": "mediastack-apprise",
      "depends_on": {
        "gluetun": "service_healthy"
      },
      "environment": {
        "PGID": "13000",
        "PUID": "13022",
        "TZ": "Etc/UTC"
      },
      "image": "lscr.io/linuxserver/apprise-api:latest",
      "labels": {
        "com.centurylinklabs.watchtower.enable": "false",
        "mediastack.auth": "gate",
        "mediastack.config": "true",
        "mediastack.desc": "one notification hub for the whole stack",
        "mediastack.managed": "true",
        "mediastack.port": "8000",
        "mediastack.subdomain": "notify",
        "mediastack.vpn": "true",
        "mediastack.vpntoggle": "true"
      },
      "network_mode": "service:gluetun",
      "profiles": [
        "apprise"
      ],
      "volumes": [
        {
          "source": "@REPO@/services/apprise/config/apprise",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "audiobookshelf": {
      "container_name": "mediastack-audiobookshelf",
      "depends_on": {
        "gluetun": "service_healthy"
      },
      "environment": {
        "PORT": "13378",
        "TZ": "Etc/UTC"
      },
      "image": "ghcr.io/advplyr/audiobookshelf:latest",
      "labels": {
        "com.centurylinklabs.watchtower.enable": "false",
        "mediastack.auth": "native",
        "mediastack.cache": "true",
        "mediastack.config": "true",
        "mediastack.desc": "audiobook + podcast server with progress sync",
        "mediastack.hostport": "local",
        "mediastack.managed": "true",
        "mediastack.port": "13378",
        "mediastack.subdomain": "audiobooks",
        "mediastack.user_facing": "true",
        "mediastack.vpn": "true",
        "mediastack.vpntoggle": "true"
      },
      "network_mode": "service:gluetun",
      "profiles": [
        "audiobookshelf"
      ],
      "user": "13026:13000",
      "volumes": [
        {
          "source": "@REPO@/services/audiobookshelf/config/audiobookshelf",
          "target": "/config",
          "type": "bind"
        },
        {
          "source": "@REPO@/services/audiobookshelf/cache/audiobookshelf",
          "target": "/metadata",
          "type": "bind"
        },
        {
          "source": "@REPO@/services/audiobookshelf/data/media/audiobooks",
          "target": "/audiobooks",
          "type": "bind"
        },
        {
          "source": "@REPO@/services/audiobookshelf/data/media/podcasts",
          "target": "/podcasts",
          "type": "bind"
        }
      ]
    },
    "deluge": {
      "container_name": "mediastack-deluge",
      "depends_on": {
        "gluetun": "service_healthy"
      },
      "environment": {
        "PGID": "13000",
        "PUID": "13014",
        "TZ": "Etc/UTC",
        "UMASK": "002"
