          "target": "/config",
          "type": "bind"
        },
        {
          "source": "@REPO@/services/deluge/data/torrent",
          "target": "/data/torrent",
          "type": "bind"
        }
      ]
    },
    "gluetun": {
      "cap_add": [
        "NET_ADMIN"
      ],
      "container_name": "mediastack-gluetun",
      "devices": [
        {
          "permissions": "rwm",
          "source": "/dev/net/tun",
          "target": "/dev/net/tun"
