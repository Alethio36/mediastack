# the portal: Traefik + authentik + production certificates + the panel, and
# every household and admin app that has no either/or with another
COMPOSE_PROFILES=gluetun,qbittorrent,sonarr,sonarr-anime,radarr,radarr-4k,lidarr,prowlarr,flaresolverr,bazarr,cleanuparr,lazylibrarian,jellyfin,meilisearch,jellysearch,seerr,watchstate,ersatztv,navidrome,kavita,audiobookshelf,apprise,pihole,olivetin,traefik,authentik
STACK_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=fixture-cloudflare-token
TRAEFIK_DASH_USER=admin
TRAEFIK_DASH_PASSWORD=fixture-dash-password
ACME_ENV=production
# a name that needs escaping in the email templates (HTML and Django braces)
PORTAL_TITLE=Tom & Jo's <Media> {Portal}
# secrets with values, so test-safety.sh can prove none leaks past an environment
AUTHENTIK_SECRET_KEY=fixture-secret-authentik-key
AUTHENTIK_DB_PASSWORD=fixture-secret-authentik-db
AUTHENTIK_LDAP_BIND_PASSWORD=fixture-secret-ldap-bind
AUTHENTIK_LDAP_TOKEN=fixture-secret-ldap-token
WIREGUARD_PRIVATE_KEY=fixture-secret-wireguard
MEILI_MASTER_KEY=fixture-secret-meili
PIHOLE_PASSWORD=fixture-secret-pihole
QBITTORRENT_PASSWORD=fixture-secret-qbittorrent
