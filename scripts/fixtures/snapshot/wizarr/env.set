# invite links (Wizarr) behind Traefik, staging certificates
COMPOSE_PROFILES=gluetun,qbittorrent,sonarr,radarr,prowlarr,jellyfin,seerr,wizarr,traefik
TRAEFIK_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com
CF_DNS_API_TOKEN=fixture-cloudflare-token
TRAEFIK_DASH_USER=admin
TRAEFIK_DASH_PASSWORD=fixture-dash-password
ACME_ENV=staging
