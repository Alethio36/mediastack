        "traefik.http.routers.bazarr.middlewares": "mediastack-gate@file",
        "traefik.http.routers.bazarr.rule": "Host(`bazarr.media.example.com`)",
        "traefik.http.routers.bazarr.service": "bazarr",
        "traefik.http.routers.bazarr.tls": "true",
        "traefik.http.routers.deluge.entrypoints": "websecure",
        "traefik.http.routers.deluge.middlewares": "mediastack-gate@file",
