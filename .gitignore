# Deployment state — never tracked. `git status` stays clean on a healthy
# deployment so `git pull` always fast-forwards.
.env
# the folders are the repo root's alone (a leading /): unanchored, a name
# like config/ would also hide a future services/<x>/config/ from git
/custom/
/config/
/cache/
/data/
/transcodes/
/backups/
/local/
# where an install before schema 28 kept them — moved on upgrade; ignored
# until then, so the upgrade that moves them never sees them as untracked
.env.bak.*
.pins.yml
.wired
docker-compose.override.yml

# your answers for configure --answers (answers.example is the blank one):
# they hold secrets
/answers*.env

# Per-session working notes (handoffs) — local state, kept out of the public repo
session.txt

# a test's temporary copy of the entrypoint (mktemp in the repo root),
# left behind when a run is killed before its cleanup — never committed
/.test-*
/.safety-live.*
