# answers.example — configure's questions, answered ahead (docs/design-answers.md).
# Generated by scripts/gen-answers.sh from the schema and the services' labels:
# change those, not this file.
#
# Copy it, answer what you want, leave the rest blank, keep it yours alone:
#   cp answers.example answers.env && chmod 600 answers.env
#   ./mediastack.sh install --answers answers.env      (or: configure --answers ...)
# A written answer is used. A blank one keeps what is already set; on a first
# install it takes the recommendation, or is asked — and with no terminal,
# an answer that would be asked must be written. Values follow .env's rules:
# no quotes, and no comment after a value (comments go on their own line).
# A yes/no answer takes yes, no, y, n, true or false; a path starting ~ is
# your home, a relative one is inside this folder.
# answers*.env is git-ignored: your answers never reach the repo.

# ---------------------------------------------------- how configure runs --

# how much configure asks: quick (only what has no recommended answer) or full
#   quick | full — recommended: quick
CONFIGURE_MODE=

# configure's closing question: start (or apply) everything now
#   yes | no — recommended: yes on a first run, no on a live stack
START=

# -------------------------------------------------------------- services --
# yes runs it, no leaves it off. Answer one and the blank ones take the standard
# preset (on a re-run: what runs now); answer none and the question is asked.
# --services a,b on the command line names the exact set instead.

# one notification hub for the whole stack
#   yes | no — recommended: no
ENABLE_APPRISE=

# audiobook + podcast server with progress sync
#   yes | no — recommended: no
ENABLE_AUDIOBOOKSHELF=

# subtitle automation
#   yes | no — recommended: no
ENABLE_BAZARR=

# strikes stalled downloads, cleans up the queue
#   yes | no — recommended: no
ENABLE_CLEANUPARR=

# expose services without port-forwarding
#   yes | no — recommended: no
ENABLE_CLOUDFLARED=

# extra torrent client (most people do not need it)
#   yes | no — recommended: no
ENABLE_DELUGE=

# virtual live-TV channels from your library
#   yes | no — recommended: no
ENABLE_ERSATZTV=

# captcha bypass helper for some indexers
#   yes | no — recommended: no
ENABLE_FLARESOLVERR=

# VPN gateway — all download traffic exits through this tunnel
#   yes | no — recommended: yes
ENABLE_GLUETUN=

# the media server your users watch
#   yes | no — recommended: yes
ENABLE_JELLYFIN=

# instant, typo-tolerant Jellyfin search
#   yes | no — recommended: yes
ENABLE_JELLYSEARCH=

# reading server for ebooks, comics and manga
#   yes | no — recommended: no
ENABLE_KAVITA=

# book acquisition (Readarr replacement)
#   yes | no — recommended: no
ENABLE_LAZYLIBRARIAN=

# music automation
#   yes | no — recommended: no
ENABLE_LIDARR=

# search engine backing JellySearch
#   yes | no — recommended: yes
ENABLE_MEILISEARCH=

# music server (Subsonic API) over lidarr's library
#   yes | no — recommended: no
ENABLE_NAVIDROME=

# GUI reverse proxy + certificates (alternative to traefik)
#   yes | no — recommended: no
ENABLE_NPM=

# network-wide ad-blocking DNS
#   yes | no — recommended: no
ENABLE_PIHOLE=

# indexer manager feeding the arrs
#   yes | no — recommended: yes
ENABLE_PROWLARR=

# torrent client (runs inside the VPN)
#   yes | no — recommended: yes
ENABLE_QBITTORRENT=

# movie automation
#   yes | no — recommended: yes
ENABLE_RADARR=

# second Radarr just for 4K movies (own library + rules)
#   yes | no — recommended: no
ENABLE_RADARR_4K=

# request/discovery site for your users
#   yes | no — recommended: yes
ENABLE_SEERR=

# TV show automation
#   yes | no — recommended: yes
ENABLE_SONARR=

# second Sonarr just for anime (own library + rules)
#   yes | no — recommended: no
ENABLE_SONARR_ANIME=

# HTTPS names for every service, one certificate through Cloudflare DNS (recommended)
#   yes | no — recommended: no
ENABLE_TRAEFIK=

# extra torrent client (most people do not need it)
#   yes | no — recommended: no
ENABLE_TRANSMISSION=

# syncs + backs up per-user watch state across media servers
#   yes | no — recommended: no
ENABLE_WATCHSTATE=

# --------------------------------------------------- how people sign in --

# how people sign in: none, Wizarr or authentik (the portal)
#   none | wizarr | authentik — no recommendation — asked when it applies; with no terminal it must be written
SIGNIN=

# -------------------------------------------------------------- the stack --

# the one username of the stack's own logins (configure; a login already made keeps its name)
#   any single-line text — recommended: admin
STACK_USER=

# how the stack's own logins get their passwords: generated, one shared (unified), or typed for each (configure)
#   generated | unified | each — recommended: generated
STACK_LOGINS=

# the stack's domain: every HTTPS name lives under it — the portal, Wizarr's links, Jellyfin's LDAP host (traefik-setup)
#   a domain, e.g. media.example.com — no recommendation — asked when it applies; with no terminal it must be written
STACK_DOMAIN=

# the stack's time zone — apps and the schedules (a name under /usr/share/zoneinfo, e.g. America/Los_Angeles)
#   a time zone name, e.g. Etc/UTC or Europe/Berlin — recommended: this host's time zone
TZ=

# where one kind of state lives (configure asks; stored absolute)
#   a folder path — recommended: ./config
CONFIG_ROOT=

# where one kind of state lives (configure asks; stored absolute)
#   a folder path — recommended: ./data
DATA_ROOT=

# where one kind of state lives (configure asks; stored absolute)
#   a folder path — recommended: ./cache
CACHE_ROOT=

# where one kind of state lives (configure asks; stored absolute)
#   a folder path — recommended: ./transcodes
TRANSCODE_ROOT=

# where one kind of state lives (configure asks; stored absolute)
#   a folder path — recommended: ./backups
BACKUP_ROOT=

# the download client the arrs, Prowlarr and Cleanuparr use when several are enabled (empty: the first enabled)
#   qbittorrent | deluge | transmission — recommended: the first one enabled, in the default priority order
DOWNLOAD_CLIENT=

# when automatic updates run (systemd OnCalendar; empty = no timer)
#   a systemd OnCalendar expression, e.g. *-*-* 03:30 (check: systemd-analyze calendar '...') (or never) — recommended: Tue 04:00
UPDATE_SCHEDULE=

# when automatic backups run (systemd OnCalendar; empty = no timer; skipped after an update's restore point)
#   a systemd OnCalendar expression, e.g. *-*-* 03:30 (check: systemd-analyze calendar '...') (or never) — recommended: daily, an hour after the update
BACKUP_SCHEDULE=

# the one password of the stack's own logins, with STACK_LOGINS=unified
#   any single-line text — no recommendation — asked when it applies; with no terminal it must be written — a secret: keep this file yours alone (chmod 600)
STACK_PASSWORD=

# ------------------------------------------------------------ the arrs --

# the shared arr password (configure records it; set-credentials arr)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
ARR_PASSWORD=

# ------------------------------------------------------------ apprise --

# the ops stream's Apprise URLs, comma-separated (one-shot: handed to the hub by wire apprise)
#   any single-line text — optional: blank leaves it unset — a secret: keep this file yours alone (chmod 600)
NOTIFY_OPS=

# the users stream's Apprise URLs, comma-separated (one-shot: handed to the hub by wire apprise)
#   any single-line text — optional: blank leaves it unset — a secret: keep this file yours alone (chmod 600)
NOTIFY_USERS=

# ------------------------------------------------------------ audiobookshelf --

# Audiobookshelf's root password (configure records it; set-credentials audiobookshelf)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
ABS_ADMIN_PASSWORD=

# ------------------------------------------------------------ authentik --

# the portal's name on its login and sign-up pages (authentik; default Mediastack)
#   any single-line text — recommended: Mediastack
PORTAL_TITLE=

# the mail server the portal sends through (empty = no email; docs/email.md)
#   a host name label, e.g. notify (lowercase, digits, - and .) — optional: blank leaves it unset
SMTP_HOST=

# its port: 587 (STARTTLS), 465 (TLS), 25 (a relay on your LAN)
#   a port number (1-65535) — optional: blank leaves it unset
SMTP_PORT=

# connect plain, then upgrade to TLS (port 587) — not with SMTP_TLS
#   yes | no — optional: blank leaves it unset
SMTP_STARTTLS=

# TLS from the first byte (port 465) — not with SMTP_STARTTLS
#   yes | no — optional: blank leaves it unset
SMTP_TLS=

# the login at the mail server (empty: it takes none)
#   any single-line text — optional: blank leaves it unset
SMTP_USER=

# that login's password — an app password or the service's SMTP key
#   any single-line text — optional: blank leaves it unset — a secret: keep this file yours alone (chmod 600)
SMTP_PASSWORD=

# the address mail comes from (one the server lets you send as)
#   an e-mail address — optional: blank leaves it unset
SMTP_FROM=

# ------------------------------------------------------------ cloudflared --

# Cloudflare tunnel token (cloudflared)
#   any single-line text — optional: blank leaves it unset — a secret: keep this file yours alone (chmod 600)
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------ deluge --

# Deluge's web password — one of the stack's own (configure records it; set-credentials deluge)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
DELUGE_PASSWORD=

# ------------------------------------------------------------ gluetun --

# the gluetun VPN provider name
#   any single-line text — no recommendation — asked when it applies; with no terminal it must be written
VPN_PROVIDER=

# the VPN's WireGuard private key
#   any single-line text — no recommendation — asked when it applies; with no terminal it must be written — a secret: keep this file yours alone (chmod 600)
WIREGUARD_PRIVATE_KEY=

# the WireGuard interface address (e.g. 10.5.0.2/32)
#   any single-line text — recommended: 10.5.0.2/32
WIREGUARD_ADDRESSES=

# limit the VPN to these countries (comma-separated; empty = any)
#   any single-line text (or auto) — recommended: auto
VPN_SERVER_COUNTRIES=

# NordVPN's access token — configure turns it into WIREGUARD_PRIVATE_KEY
#   any single-line text — no recommendation — asked when it applies; with no terminal it must be written — a secret: keep this file yours alone (chmod 600)
NORDVPN_TOKEN=

# ------------------------------------------------------------ jellyfin --

# Jellyfin's admin password (configure records it; set-credentials jellyfin)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
JELLYFIN_ADMIN_PASSWORD=

# the name Jellyfin's apps and casting show (configure asks; wire sets it once, while Jellyfin still shows its ID)
#   any single-line text — recommended: Jellyfin
JELLYFIN_SERVER_NAME=

# ------------------------------------------------------------ kavita --

# Kavita's admin password (configure records it; set-credentials kavita)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
KAVITA_ADMIN_PASSWORD=

# ------------------------------------------------------------ olivetin --

# install the web panel (asked with Traefik on and no panel yet)
#   yes | no — recommended: yes
PANEL=

# ------------------------------------------------------------ pihole --

# Pi-hole's web password — one of the stack's own (configure records it; set-credentials pihole)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
PIHOLE_PASSWORD=

# ------------------------------------------------------------ qbittorrent --

# qBittorrent's password (configure records it; set-credentials qbit)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
QBITTORRENT_PASSWORD=

# ------------------------------------------------------------ recyclarr --

# the TRaSH quality profile trash-sync applies to that arr — asked: 1080p, 720p, 4k or skip (radarr)
#   any single-line text — recommended: 1080p
TRASH_PROFILE_RADARR=

# the TRaSH quality profile trash-sync applies to that arr — asked: 1080p, 720p, 4k or skip (sonarr)
#   any single-line text — recommended: 1080p
TRASH_PROFILE_SONARR=

# ------------------------------------------------------------ traefik --

# Cloudflare DNS token for certificates (traefik-setup)
#   any single-line text — no recommendation — asked when it applies; with no terminal it must be written — a secret: keep this file yours alone (chmod 600)
CF_DNS_API_TOKEN=

# certificate contact address (traefik-setup)
#   an e-mail address — no recommendation — asked when it applies; with no terminal it must be written
ACME_EMAIL=

# which certificates Traefik requests (traefik-setup --certs)
#   staging | production — recommended: production
ACME_ENV=

# the Traefik dashboard's password (configure records it; set-credentials traefik)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
TRAEFIK_DASH_PASSWORD=

# where the certificate comes from: Let's Encrypt through Cloudflare, or your own files (configure; traefik-setup --certs)
#   letsencrypt | own — recommended: letsencrypt
TLS_SOURCE=

# your certificate, PEM, with its chain (TLS_SOURCE=own; up copies it in when it changes)
#   a file path — no recommendation — asked when it applies; with no terminal it must be written
TLS_CERT_FILE=

# its private key, PEM, unencrypted (TLS_SOURCE=own)
#   a file path — no recommendation — asked when it applies; with no terminal it must be written
TLS_KEY_FILE=

# ------------------------------------------------------------ transmission --

# Transmission's password (configure records it; set-credentials transmission; its container carries it)
#   any single-line text — only with STACK_LOGINS=each, where blank asks it (generated otherwise, or STACK_PASSWORD's) — a secret: keep this file yours alone (chmod 600)
TRANSMISSION_PASSWORD=
